{
  "name": "rateforces",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k -n api,web,worker -c blue,green,magenta \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:api": "npm --workspace @rateforces/api run dev",
    "dev:web": "npm --workspace @rateforces/web run dev",
    "dev:worker": "npm --workspace @rateforces/worker run dev",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm --workspace @rateforces/api run test",
    "test:integration": "npm --workspace @rateforces/api run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm --workspace @rateforces/api run db:generate",
    "db:migrate": "npm --workspace @rateforces/api run db:migrate",
    "db:deploy": "npm --workspace @rateforces/api run db:deploy"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
