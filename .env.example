# Neon pooled connection for API and worker runtime. Replace with the value from Neon Connect.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require
# Neon direct connection for Prisma migration commands (remove -pooler from the host).
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
CODEFORCES_API_BASE=https://codeforces.com/api
CODEFORCES_REQUEST_INTERVAL_MS=2100
VERIFICATION_CONTEST_ID=
VERIFICATION_PROBLEM_INDEX=
SESSION_SECRET=replace-with-a-long-random-secret
