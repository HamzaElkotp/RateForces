{
  "name": "@rateforces/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test scripts/test-runner.mjs",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:migrate": "node scripts/prisma.mjs migrate dev",
    "db:deploy": "node scripts/prisma.mjs migrate deploy",
    "crawl:problemset": "tsx src/crawl-problemset.ts",
    "auth:poll": "tsx src/auth/poll-challenges.ts",
    "auth:sync-history": "tsx src/auth/sync-history.ts",
    "rounds:sync": "tsx src/rounds/sync-submissions.ts",
    "worker:heartbeat": "tsx src/worker-heartbeat.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3"
  }
}
